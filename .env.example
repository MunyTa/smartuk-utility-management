# Для настоящей отправки через Mail.ru скопируйте значения в локальный файл .env
# и заполните свой ящик и пароль для внешнего приложения.

SMTP_HOST=smtp.mail.ru
# В этой сети стандартные порты 465/587 могут разрываться до авторизации.
# Mail.ru отвечает на альтернативном SMTP-порту 2525 с STARTTLS.
SMTP_PORT=2525
SMTP_USE_SSL=false
SMTP_USERNAME=your-address@mail.ru
SMTP_PASSWORD=your-external-app-password
SMTP_FROM_EMAIL=your-address@mail.ru
SMTP_FROM_NAME=Диспетчер УК

SMS_LOGIN=your-smsaero-email
SMS_API_KEY=your-smsaero-api-key
SMS_SENDER=SMSAero
SMS_TEST_MODE=false

VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-address@mail.ru
