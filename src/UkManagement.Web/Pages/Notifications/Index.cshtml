@page
@model UkManagement.Web.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Уведомления";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Email / SMS / сообщения в профиле</p>
        <h1>Журнал уведомлений</h1>
    </div>
    <a class="btn btn-primary" asp-page="/Notifications/Create">Новое уведомление</a>
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

<section class="panel">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th>Создано</th>
                <th>Житель</th>
                <th>Канал</th>
                <th>Тема</th>
                <th>Статус</th>
                <th>Детали доставки</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var notification in Model.Notifications)
            {
                <tr>
                    <td>@notification.CreatedAt.ToDisplayTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@notification.Resident.FullName, кв. @notification.Resident.Apartment.Number</td>
                    <td>@notification.Channel.ToDisplayName()</td>
                    <td>@notification.Subject</td>
                    <td><span class="status status-@notification.Status.ToString().ToLowerInvariant()">@notification.Status.ToDisplayName()</span></td>
                    <td>@(notification.DeliveryDetails ?? "-")</td>
                </tr>
            }
            @if (!Model.Notifications.Any())
            {
                <tr><td colspan="6" class="text-muted">Уведомления еще не создавались.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
