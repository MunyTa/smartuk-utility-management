@page
@model UkManagement.Web.Pages.ResidentArea.MessagesModel
@{
    ViewData["Title"] = "Сообщения от УК";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Житель</p>
        <h1>Сообщения от УК</h1>
    </div>
    <div class="d-flex gap-2">
        <form method="post" asp-page-handler="MarkAllRead">
            <button class="btn btn-outline-primary" type="submit" disabled="@(Model.UnreadCount == 0)">
                Отметить все прочитанными
            </button>
        </form>
        <a class="btn btn-outline-secondary" asp-page="/Resident/Index">В личный кабинет</a>
    </div>
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

<section class="metric-grid">
    <article class="metric-card">
        <span>Всего сообщений</span>
        <strong>@Model.TotalMessageCount</strong>
    </article>
    <article class="metric-card accent">
        <span>Новые</span>
        <strong>@Model.UnreadCount</strong>
    </article>
    <article class="metric-card">
        <span>Браузерные уведомления</span>
        <strong>@Model.PushSubscriptionCount</strong>
    </article>
</section>

<section class="panel">
    <div class="panel-header">
        <h2>Доставка в браузер</h2>
    </div>
    <div class="push-subscription-bar">
        <button class="btn btn-outline-primary btn-sm" type="button" id="push-subscribe-button">
            Разрешить уведомления в браузере
        </button>
        <span class="small text-muted" id="push-subscribe-status">
            @(Model.PushSubscriptionCount > 0 ? $"Активных подписок: {Model.PushSubscriptionCount}" : "Не подключено")
        </span>
    </div>
</section>

<section class="panel mt-3">
    <div class="panel-header">
        <h2>Входящие сообщения</h2>
    </div>

    <div class="message-list">
        @foreach (var message in Model.Messages)
        {
            var preview = message.Body.Length > 160 ? $"{message.Body[..157]}..." : message.Body;
            <a class="message-row @(message.ReadAt is null ? "message-row-unread" : "")"
               asp-page="/Resident/Message"
               asp-route-id="@message.Id">
                <div>
                    <div class="message-row-title">
                        <strong>@message.Subject</strong>
                        @if (message.ReadAt is null)
                        {
                            <span class="status status-pending">Новое</span>
                        }
                    </div>
                    <span>@message.CreatedAt.ToDisplayTime().ToString("dd.MM.yyyy HH:mm") · @message.Channel.ToDisplayName()</span>
                    <p>@preview</p>
                </div>
                <span class="status status-@message.Status.ToString().ToLowerInvariant()">@message.Status.ToDisplayName()</span>
            </a>
        }

        @if (!Model.Messages.Any())
        {
            <p class="text-muted mb-0">Сообщений пока нет.</p>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/push-subscriptions.js" asp-append-version="true"></script>
}
