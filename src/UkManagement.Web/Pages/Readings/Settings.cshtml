@page
@model UkManagement.Web.Pages.Readings.SettingsModel
@{
    ViewData["Title"] = "Настройки хранения показаний";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Показания приборов</p>
        <h1>Настройки хранения</h1>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Readings/Index">К журналу показаний</a>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<section class="metric-grid">
    <article class="metric-card">
        <span>Срок хранения</span>
        <strong>@Model.CurrentRetentionDays дн.</strong>
    </article>
    <article class="metric-card">
        <span>Записей в журнале</span>
        <strong>@Model.ReadingCount</strong>
    </article>
    <article class="metric-card accent">
        <span>Самая старая запись</span>
        <strong>@(Model.OldestReadingReceivedAt?.ToDisplayTime().ToString("dd.MM HH:mm") ?? "-")</strong>
    </article>
</section>

<section class="panel">
    <form method="post" class="row g-3">
        <div class="col-md-6">
            <label asp-for="Form.RetentionDays" class="form-label">Срок хранения журнала</label>
            <select asp-for="Form.RetentionDays" asp-items="Model.RetentionOptions" class="form-select"></select>
            <span asp-validation-for="Form.RetentionDays" class="text-danger"></span>
        </div>

        <div class="col-12">
            <button class="btn btn-primary" type="submit">Сохранить настройку</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
