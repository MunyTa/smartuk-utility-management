@page
@model UkManagement.Web.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Отчеты";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Аналитика и выгрузка</p>
        <h1>Отчеты по потреблению</h1>
    </div>
</section>

<section class="panel mb-3">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label asp-for="ReportType" class="form-label">Тип отчета</label>
            <select asp-for="ReportType" asp-items="Model.ReportTypeOptions" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="ApartmentId" class="form-label">Квартира</label>
            <select asp-for="ApartmentId" asp-items="Model.ApartmentOptions" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="MeterType" class="form-label">Тип прибора</label>
            <select asp-for="MeterType" asp-items="Model.MeterTypeOptions" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="From" class="form-label">С даты</label>
            <input asp-for="From" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="To" class="form-label">По дату</label>
            <input asp-for="To" type="date" class="form-control" />
        </div>
        <div class="col-md-9 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Показать</button>
            <button class="btn btn-outline-primary" type="submit" name="handler" value="Word">
                Сформировать Word-отчет
            </button>
            <a class="btn btn-outline-secondary" asp-page="/Reports/Index">Текущий месяц</a>
        </div>
    </form>
</section>

<section class="metric-grid">
    <article class="metric-card">
        <span>Квартиры</span>
        <strong>@Model.ApartmentCount</strong>
    </article>
    <article class="metric-card">
        <span>Приборы</span>
        <strong>@Model.MeterCount</strong>
    </article>
    <article class="metric-card">
        <span>Показания</span>
        <strong>@Model.ReadingsCount</strong>
    </article>
    <article class="metric-card accent">
        <span>Проблемы</span>
        <strong>@Model.ProblemRowsCount</strong>
    </article>
    <article class="metric-card">
        <span>Без данных</span>
        <strong>@Model.MetersWithoutDataCount</strong>
    </article>
</section>

@if (Model.ReportType == UtilityReportType.Consumption)
{
    <section class="panel mb-3">
        <div class="panel-header">
            <h2>Итоги по ресурсам</h2>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>Ресурс</th>
                    <th>Расход</th>
                    <th>Приборов</th>
                    <th>Показаний</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.ConsumptionSummary)
                {
                    <tr>
                        <td>@row.MeterType</td>
                        <td>@row.TotalConsumption.ToString("0.###") @row.Unit</td>
                        <td>@row.MeterCount</td>
                        <td>@row.ReadingsCount</td>
                    </tr>
                }
                @if (!Model.ConsumptionSummary.Any())
                {
                    <tr><td colspan="4" class="text-muted">Нет данных для расчета потребления за выбранный период.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <h2>Потребление по квартирам и приборам</h2>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>Квартира</th>
                    <th>Житель</th>
                    <th>Email</th>
                    <th>Прибор</th>
                    <th>Серийный номер</th>
                    <th>Начальное</th>
                    <th>Конечное</th>
                    <th>Расход</th>
                    <th>Состояние</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.ConsumptionRows)
                {
                    <tr>
                        <td>@row.ApartmentNumber</td>
                        <td>@row.Residents</td>
                        <td>@row.Emails</td>
                        <td>@row.MeterType</td>
                        <td>@row.SerialNumber</td>
                        <td>
                            @(row.FirstValue is null ? "-" : $"{row.FirstValue:0.###} {row.Unit}")
                            <span class="report-subtext">@(row.FirstMeasuredAt?.ToDisplayTime().ToString("dd.MM HH:mm") ?? "")</span>
                        </td>
                        <td>
                            @(row.LastValue is null ? "-" : $"{row.LastValue:0.###} {row.Unit}")
                            <span class="report-subtext">@(row.LastMeasuredAt?.ToDisplayTime().ToString("dd.MM HH:mm") ?? "")</span>
                        </td>
                        <td>@(row.Consumption is null ? "-" : $"{row.Consumption.Value:0.###} {row.Unit}")</td>
                        <td>
                            <span class="status status-@row.MeterStatus.ToString().ToLowerInvariant()">@row.MeterStatus.ToDisplayName()</span>
                            <span class="report-subtext">@row.QualitySummary</span>
                        </td>
                    </tr>
                }
                @if (!Model.ConsumptionRows.Any())
                {
                    <tr><td colspan="9" class="text-muted">Нет приборов, подходящих под выбранные фильтры.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
else
{
    <section class="panel">
        <div class="panel-header">
            <h2>Проблемные показания и приборы</h2>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>Квартира</th>
                    <th>Житель</th>
                    <th>Email</th>
                    <th>Прибор</th>
                    <th>Серийный номер</th>
                    <th>Проблема</th>
                    <th>Значение</th>
                    <th>Дата</th>
                    <th>Детали</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.CriticalRows)
                {
                    <tr>
                        <td>@row.ApartmentNumber</td>
                        <td>@row.Residents</td>
                        <td>@row.Emails</td>
                        <td>@row.MeterType</td>
                        <td>@row.SerialNumber</td>
                        <td>@row.Problem</td>
                        <td>@(row.Value is null ? "-" : $"{row.Value} {row.Unit}")</td>
                        <td>@(row.MeasuredAt?.ToDisplayTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                        <td>@row.Details</td>
                    </tr>
                }
                @if (!Model.CriticalRows.Any())
                {
                    <tr><td colspan="9" class="text-muted">Проблемные показания за выбранный период не найдены.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
