@page
@model IndexModel
@{
    var isAdmin = User.IsInRole("Admin");
    var isDispatcher = User.IsInRole("Dispatcher") && !isAdmin;
    ViewData["Title"] = isAdmin ? "Панель управления" : "Панель диспетчера";
}

@if (User.Identity?.IsAuthenticated != true)
{
    ViewData["Title"] = "Главная";

    <section class="page-heading">
        <div>
            <p class="eyebrow">Управляющая компания</p>
            <h1>SmartUK</h1>
        </div>
    </section>

    <section class="panel">
        <div class="row g-3 align-items-center">
            <div class="col-md-8">
                <h2 class="mb-2">Личный кабинет жильца и панель УК</h2>
                <p class="text-muted mb-0">Войдите в существующий аккаунт или подайте заявку на регистрацию нового жильца.</p>
            </div>
            <div class="col-md-4 d-flex gap-2 justify-content-md-end">
                <a class="btn btn-primary" href="/login">Войти</a>
                <a class="btn btn-outline-primary" asp-page="/Register/Index">Зарегистрироваться</a>
            </div>
        </div>
    </section>

    return;
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Управляющая компания</p>
        <h1>@(isAdmin ? "Панель управления SmartUK" : "Панель диспетчера ЖКХ")</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (isAdmin)
        {
            <a class="btn btn-outline-primary" asp-page="/Admin/Index">Администрирование</a>
        }
    </div>
</section>

@if (isAdmin)
{
    <section class="metric-grid">
        <article class="metric-card">
            <span>Жильцы</span>
            <strong>@Model.ResidentCount</strong>
        </article>
        <article class="metric-card">
            <span>Квартиры</span>
            <strong>@Model.ApartmentCount</strong>
        </article>
        <article class="metric-card">
            <span>Приборы учета</span>
            <strong>@Model.MeterCount</strong>
        </article>
        <article class="metric-card">
            <span>Уведомлений сегодня</span>
            <strong>@Model.SentNotificationsTodayCount</strong>
        </article>
    </section>

    <div class="content-grid">
        <section class="panel">
            <div class="panel-header">
                <h2>Уведомления</h2>
                <a asp-page="/Notifications/Index">Журнал</a>
            </div>
            <div class="notification-list">
                @foreach (var notification in Model.LatestNotifications)
                {
                    <article>
                        <div>
                            <strong>@notification.Subject</strong>
                            <span>@notification.Resident.FullName, кв. @notification.Resident.Apartment.Number</span>
                        </div>
                        <span class="status status-@notification.Status.ToString().ToLowerInvariant()">@notification.Status.ToDisplayName()</span>
                    </article>
                }
                @if (!Model.LatestNotifications.Any())
                {
                    <p class="text-muted mb-0">Уведомлений пока нет.</p>
                }
            </div>
        </section>
    </div>
}

@if (isDispatcher)
{
    <section class="metric-grid">
        <article class="metric-card accent">
            <span>Новые заявки</span>
            <strong>@Model.NewRequestCount</strong>
        </article>
        <article class="metric-card">
            <span>Всего заявок</span>
            <strong>@Model.TotalRequestCount</strong>
        </article>
    </section>

    <section class="panel mt-3">
        <div class="panel-header">
            <h2>Последние заявки</h2>
            <a asp-page="/Requests/Index">Все заявки</a>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>Создана</th>
                    <th>Житель</th>
                    <th>Приоритет</th>
                    <th>Статус</th>
                    <th>Тема</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var request in Model.LatestServiceRequests)
                {
                    <tr>
                        <td>@request.CreatedAt.ToDisplayTime().ToString("dd.MM HH:mm")</td>
                        <td>@request.Resident.FullName, кв. @request.Resident.Apartment.Number</td>
                        <td><span class="status status-priority-@request.Priority.ToString().ToLowerInvariant()">@request.Priority.ToDisplayName()</span></td>
                        <td><span class="status status-request-@request.Status.ToString().ToLowerInvariant()">@request.Status.ToDisplayName()</span></td>
                        <td>@request.Title</td>
                        <td class="text-end"><a class="btn btn-outline-secondary btn-sm" asp-page="/Requests/Details" asp-route-id="@request.Id">Открыть</a></td>
                    </tr>
                }
                @if (!Model.LatestServiceRequests.Any())
                {
                    <tr><td colspan="6" class="text-muted">Заявок пока нет.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
